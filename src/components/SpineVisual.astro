<div class="visual reveal" aria-label="椎体、脊柱管、椎間板のセグメンテーション模式図">
  <div class="scan-label">T2 SPACE segmentation map</div>
  <div class="spine-map">
    <div class="vertebrae-stack" aria-hidden="true">
      <div class="vertebra" style="--shift: 16px"></div>
      <div class="vertebra" style="--shift: 3px"></div>
      <div class="vertebra" style="--shift: -8px"></div>
      <div class="vertebra" style="--shift: -2px"></div>
      <div class="vertebra" style="--shift: 10px"></div>
    </div>
    <div class="canal" aria-hidden="true"></div>
    <div class="disc-stack" aria-hidden="true">
      <div class="disc" style="--shift: -6px"></div>
      <div class="disc" style="--shift: 8px"></div>
      <div class="disc" style="--shift: 0"></div>
      <div class="disc" style="--shift: 14px"></div>
      <div class="disc" style="--shift: 2px"></div>
      <div class="disc" style="--shift: -10px"></div>
    </div>
  </div>
  <div class="legend">
    <span><i class="dot" style="--c: var(--vertebrae)"></i>椎体 Vertebrae</span>
    <span><i class="dot" style="--c: var(--canal)"></i>脊柱管 Spinal Canal</span>
    <span><i class="dot" style="--c: var(--disc)"></i>椎間板 IVDs</span>
  </div>
</div>
